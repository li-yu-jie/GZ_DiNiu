<?xml version="1.0"?>
<package format="3">
  <!-- 功能包名称：GPIO 输入输出控制 -->
  <name>io_control_py</name>
  <version>0.0.1</version>
  <!-- 包描述：支持 Joy 与 ROS 话题双通道控制 GPIO -->
  <description>GPIO IO control node using pigpio, Joy, and ROS topics.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <!-- Python 包构建系统 -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- 运行依赖：
       rclpy：Python ROS2 节点基础
       sensor_msgs：Joy 手柄消息
       std_msgs：Bool 状态与命令消息 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <!-- 指定构建类型 -->
    <build_type>ament_python</build_type>
  </export>
</package>
