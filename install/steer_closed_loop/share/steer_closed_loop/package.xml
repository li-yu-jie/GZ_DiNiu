<?xml version="1.0"?>
<package format="3">
  <!-- 功能包名称：转向闭环控制 -->
  <name>steer_closed_loop</name>
  <version>0.0.1</version>
  <!-- 包描述：基于霍尔编码器、GPIO 和 PWM 的转向位置闭环 -->
  <description>Steering closed-loop control node using libgpiod and sysfs PWM.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <!-- C++ 构建工具 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行依赖：
       rclcpp：ROS2 C++ 节点框架
       std_msgs：目标角度、反馈角度、编码器计数等消息 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <!-- 声明使用 ament_cmake -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
