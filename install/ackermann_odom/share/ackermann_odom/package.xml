<?xml version="1.0"?>
<package format="3">
  <!-- 功能包名称：阿克曼底盘里程计解算节点 -->
  <name>ackermann_odom</name>
  <version>0.0.1</version>
  <!-- 包描述：根据线速度和转向角发布标准 /odom -->
  <description>Odometry publisher from wheel linear velocity and steering angle.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <!-- 构建工具：C++ ament_cmake -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行依赖：
       rclcpp：ROS2 C++ 客户端库
       std_msgs：速度/转角订阅常用基础消息
       nav_msgs：Odometry 消息定义
       geometry_msgs：姿态四元数等几何消息 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  <export>
    <!-- 声明本包采用 ament_cmake 构建 -->
    <build_type>ament_cmake</build_type>
  </export>
</package>
